{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-ground-truth",
  "description": "Figma 导出的精确样式锁定文件，design-to-code skill 用它做反捏造机械校验。详见 references/ground-truth-lock.md。v2: raw_styles 按节点 + role 标注，fills/strokes 区分背景/边框/文字。",
  "type": "object",
  "required": ["source"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["via", "exported_at"],
      "additionalProperties": false,
      "properties": {
        "figma_file": { "type": "string" },
        "frame_node_id": { "type": "string" },
        "exported_at": { "type": "string", "format": "date-time" },
        "via": {
          "type": "string",
          "description": "导出方式：必须是 framelink get_figma_data（其他值视为伪造）"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "description": "扁平的值清单，只记值不记应用关系",
          "items": {
            "type": "object",
            "required": ["name", "value", "nodeId"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string", "pattern": "^#" },
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$", "description": "必须是真实 Figma nodeId 格式（纯数字冒号），不接受 :purple :bg 这种英文后缀" },
              "path": { "type": "string" }
            }
          }
        },
        "typography": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "fontSize", "nodeId"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "fontSize": { "type": "number" },
              "fontWeight": { "type": ["number", "string"] },
              "fontFamily": { "type": "string" },
              "lineHeight": { "type": ["number", "string"] },
              "letterSpacing": { "type": ["number", "string"] },
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" }
            }
          }
        },
        "spacing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "nodeId"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "number" },
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" },
              "path": { "type": "string" }
            }
          }
        },
        "radius": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "nodeId"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "number" },
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "raw_styles": {
      "type": "array",
      "description": "按节点记录的角色化样式。每个节点一条，fills[role=background] 是背景、strokes[role=border] 是边框、textColor 是文字色。这是 ground-truth 的核心——让模型生成 CSS 时不用靠截图猜白底灰边的应用关系，直接查每个节点的 fills/strokes 角色。",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["nodeId", "role", "fills"],
        "additionalProperties": false,
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^\\d+:\\d+$",
            "description": "真实 Figma nodeId，纯数字冒号格式"
          },
          "name": {
            "type": "string",
            "description": "节点在 Figma 里的图层名，人类可读（如 'Card'、'Submit Button'）"
          },
          "role": {
            "type": "string",
            "description": "语义角色，给模型生成语义化 className 用",
            "enum": ["card", "button", "input", "text", "icon", "container", "badge", "divider", "image", "nav", "header", "footer", "table-header", "table-row", "other"]
          },
          "fills": {
            "type": "array",
            "description": "该节点的填充列表，每条带 role 标注",
            "items": {
              "type": "object",
              "required": ["color", "role"],
              "additionalProperties": false,
              "properties": {
                "color": { "type": "string", "description": "hex 或 rgba，如 #FFFFFF / rgba(0,0,0,0.16)" },
                "role": {
                  "type": "string",
                  "enum": ["background", "surface", "gradient-stop", "shadow", "overlay", "other"],
                  "description": "background=主背景, surface=卡片表面, shadow=阴影, overlay=蒙层"
                },
                "opacity": { "type": "number", "description": "0-1，可选" }
              }
            }
          },
          "strokes": {
            "type": "array",
            "description": "该节点的描边/边框列表",
            "items": {
              "type": "object",
              "required": ["color", "role"],
              "additionalProperties": false,
              "properties": {
                "color": { "type": "string" },
                "role": {
                  "type": "string",
                  "enum": ["border", "outline", "divider", "other"],
                  "description": "border=卡片边框, divider=分割线"
                },
                "width": { "type": "number", "description": "px" }
              }
            }
          },
          "textColor": {
            "type": "string",
            "description": "如果是 TEXT 节点，记录文字颜色（hex/rgba）"
          },
          "textStyle": {
            "type": "object",
            "description": "如果是 TEXT 节点，引用 tokens.typography 里的 name",
            "additionalProperties": false,
            "properties": {
              "ref": { "type": "string", "description": "tokens.typography 里的 name，如 'Body M'" },
              "fontSize": { "type": "number" },
              "fontWeight": { "type": ["number", "string"] },
              "fontFamily": { "type": "string" }
            }
          },
          "cornerRadius": { "type": "number", "description": "px" },
          "padding": {
            "type": "string",
            "description": "CSS shorthand，如 '20px 16px'"
          },
          "gap": { "type": "number", "description": "itemSpacing, px" },
          "layoutMode": {
            "type": "string",
            "enum": ["horizontal", "vertical", "none"],
            "description": "Figma auto-layout 方向"
          }
        }
      }
    }
  }
}
